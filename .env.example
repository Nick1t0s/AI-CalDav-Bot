# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID пользователей, которым разрешён доступ (через запятую).
# Пусто = доступ запрещён всем.
ALLOWED_USER_IDS=123456789

# --- CalDAV (Яндекс Календарь) ---
# Логин = полная почта @yandex.ru, пароль = App password типа «Календарь»
# (https://id.yandex.ru/security/app-passwords)
CALDAV_URL=https://caldav.yandex.ru
CALDAV_USERNAME=you@yandex.ru
CALDAV_PASSWORD=app_password_here

# Опционально: если client.principal() не сработает
# CALDAV_PRINCIPAL_PATH=
# Опционально: прямой URL календаря
# CALENDAR_PATH=
# Опционально: выбрать календарь по имени
# CALENDAR_ID=

# --- Часовой пояс ---
TZ=Europe/Moscow

# Окно поиска (дней вперёд) для запросов «когда <событие>» / «что у меня есть» без даты.
# LIST_DEFAULT_DAYS=90

# Уровень логов: INFO (обычный) | DEBUG (печатает весь диалог модели перед каждым вызовом LLM).
# LOG_LEVEL=INFO

# --- Агент (function calling) ---
# Провайдер должен поддерживать tools.
# AGENT_MAX_STEPS=8
# AGENT_SESSION_TTL_MIN=30
# AGENT_HISTORY_LIMIT=30
# AGENT_CATALOG_LIMIT=50

# --- OpenAI-совместимый API (OpenAI / OpenRouter / vLLM ...) ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Мышление модели: enabled (по умолчанию) | disabled.
# Для deepseek-v4-pro/flash, где мышление включено по умолчанию, disabled отключает
# его (отправляются reasoning.enabled=false и thinking.type=disabled).
# OPENAI_THINKING=disabled

# --- STT (распознавание голосовых сообщений) ---
# Отдельный API-ключ OpenAI обязателен, если OPENAI_BASE_URL указывает на
# провайдера без аудио-эндпоинта (OpenRouter, vLLM и т.п.).
# Если STT_API_KEY пуст — используется OPENAI_API_KEY.
# STT_API_KEY=sk-...
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1
# STT_LANGUAGE=ru
